# PostgreSQL connection for Voka
VOKA_DB_HOST=127.0.0.1
VOKA_DB_PORT=5432
VOKA_DB_NAME=voka
VOKA_DB_USER=postgres
VOKA_DB_PASSWORD=
# Alternatively set DATABASE_URL instead of the VOKA_DB_* variables.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Qdrant vector database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Embedding model (runs locally via sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto  # auto, cpu, cuda, mps

# Retrieval settings
MEMORY_TOP_K=5
KNOWLEDGE_TOP_K=5
MEMORY_SCORE_THRESHOLD=0.7
KNOWLEDGE_SCORE_THRESHOLD=0.6

# Document ingestion
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50